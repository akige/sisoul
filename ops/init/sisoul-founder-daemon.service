# systemd service template for the sisoul founder-agent daemon (@founder).
#
# This is a TEMPLATE: __USER__ / __HOME__ are placeholders. Install with the
# helper which substitutes them for the current user, or edit by hand:
#
#   ops/init/install-founder-daemon.sh
#
# Or manually:
#   sed -e "s|__USER__|$USER|g" -e "s|__HOME__|$HOME|g" \
#       ops/init/sisoul-founder-daemon.service | sudo tee \
#       /etc/systemd/system/sisoul-founder-daemon.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sisoul-founder-daemon
#
# Optionally set SISOUL_NEWAPI_API_KEY / SISOUL_NEWAPI_BASE_URL to enable real LLM.

[Unit]
Description=sisoul founder-agent daemon (@founder)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/sisoul-dev
Environment=SISOUL_VAULT=__HOME__/.sisoul-founder
# Uncomment + fill to enable real LLM:
# Environment=SISOUL_NEWAPI_API_KEY=YOUR_NEWAPI_VIRTUAL_KEY
# Environment=SISOUL_NEWAPI_BASE_URL=http://127.0.0.1:4000/v1
ExecStart=__HOME__/sisoul-dev/.venv/bin/uvicorn sisoul.daemon:app --host 127.0.0.1 --port 9876
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/sisoul-founder-daemon.log
StandardError=append:/var/log/sisoul-founder-daemon.err.log

# Resource limits — founder daemon is lightweight
MemoryMax=512M
TasksMax=128

# Security hardening (best-effort, may be relaxed if your vault is elsewhere)
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__HOME__/.sisoul-founder /var/log

[Install]
WantedBy=multi-user.target

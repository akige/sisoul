{
  "appId": "io.sisoul.pwa",
  "appName": "sisoul",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false,
    "scheme": "sisoul"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_sisoul",
      "iconColor": "#5f8cff",
      "sound": "beep.wav"
    }
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "sisoul",
    "hostname": "app.sisoul.local",
    "allowNavigation": [
      "*.sisoul.io",
      "127.0.0.1:9876",
      "localhost:9876"
    ]
  }
}
